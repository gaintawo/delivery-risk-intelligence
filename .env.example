# Copy to .env and fill in. .env is git-ignored.
# Warehouse: SQLite by default; set to PostgreSQL in production (Module 1 stack).
DATABASE_URL=postgresql://dri_user:CHANGE_ME@localhost:5432/dri
# Secret salt for pseudonymising IDs. Never commit the real value.
DRI_HASH_SALT=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Name recorded in the privacy audit log.
DRI_ACTOR=your-name
GCS_BUCKET=dri-raw-data
MLFLOW_TRACKING_URI=http://localhost:5000
